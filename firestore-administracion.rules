rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        // =========================================
        // FUNCIONES REUTILIZABLES
        // =========================================

        function sesionActiva() {

            return request.auth != null;

        }


        function esPropietario(usuarioId) {

            return sesionActiva()
                && request.auth.uid == usuarioId;

        }


        function perfilActual() {

            return get(
                /databases/$(database)/documents/usuarios/$(request.auth.uid)
            ).data;

        }


        function esSistemaPlanetario() {

            return sesionActiva()
                && perfilActual().rol == "sistema-planetario"
                && perfilActual().oficial == true
                && perfilActual().verificado == true;

        }


        /*
         * Permiso administrativo del panel.
         * A diferencia de esSistemaPlanetario(), no exige que la cuenta
         * sea oficial o verificada: la autorización depende del rol.
         */

        function esAdministrador() {

            return sesionActiva()

                && exists(
                    /databases/$(database)/documents/usuarios/$(request.auth.uid)
                )

                && perfilActual().rol
                    in [
                        "sistema-planetario",
                        "administrador"
                    ];

        }


        /*
         * Contrato completo del documento administrado.
         * Impide campos inesperados, tipos incorrectos y que el cliente
         * suplante al usuario que realizó la actualización.
         */

        function lanzamientoValido() {

            return request.resource.data.keys()
                .hasAll([
                    "titulo",
                    "descripcion",
                    "fecha",
                    "imagen",
                    "disponibilidad",
                    "spotify",
                    "appleMusic",
                    "hiloComentariosId",
                    "visible",
                    "actualizadoEn",
                    "actualizadoPor",
                    "actualizadoPorNombre"
                ])

                && request.resource.data.keys()
                    .hasOnly([
                        "titulo",
                        "descripcion",
                        "fecha",
                        "imagen",
                        "disponibilidad",
                        "spotify",
                        "appleMusic",
                        "hiloComentariosId",
                        "visible",
                        "actualizadoEn",
                        "actualizadoPor",
                        "actualizadoPorNombre"
                    ])

                && request.resource.data.titulo
                    is string

                && request.resource.data.titulo.size()
                    > 0

                && request.resource.data.titulo.size()
                    <= 120

                && request.resource.data.descripcion
                    is string

                && request.resource.data.descripcion.size()
                    > 0

                && request.resource.data.descripcion.size()
                    <= 600

                && request.resource.data.fecha
                    is timestamp

                && request.resource.data.imagen
                    is string

                && request.resource.data.imagen.size()
                    <= 1000

                && request.resource.data.disponibilidad
                    is string

                && request.resource.data.disponibilidad.size()
                    > 0

                && request.resource.data.disponibilidad.size()
                    <= 160

                && request.resource.data.spotify
                    is string

                && request.resource.data.spotify.size()
                    <= 1000

                && request.resource.data.appleMusic
                    is string

                && request.resource.data.appleMusic.size()
                    <= 1000

                && request.resource.data.hiloComentariosId
                    is string

                && request.resource.data.hiloComentariosId.size()
                    > 0

                && request.resource.data.hiloComentariosId.size()
                    <= 120

                && request.resource.data.hiloComentariosId.matches(
                    '^[A-Za-z0-9_-]+$'
                )

                && request.resource.data.visible
                    is bool

                && request.resource.data.actualizadoEn
                    == request.time

                && request.resource.data.actualizadoPor
                    == request.auth.uid

                && request.resource.data.actualizadoPorNombre
                    is string

                && request.resource.data.actualizadoPorNombre.size()
                    <= 120;

        }


        function comentarioContextualValido() {

            return request.resource.data.keys().hasAll([
                    "texto",
                    "autorId",
                    "autorNombre",
                    "autorFoto",
                    "creadoEn",
                    "actualizadoEn"
                ])
                && request.resource.data.keys().hasOnly([
                    "texto",
                    "autorId",
                    "autorNombre",
                    "autorFoto",
                    "creadoEn",
                    "actualizadoEn"
                ])
                && request.resource.data.texto is string
                && request.resource.data.texto.size() > 0
                && request.resource.data.texto.size() <= 500
                && request.resource.data.autorId == request.auth.uid
                && request.resource.data.autorNombre is string
                && request.resource.data.autorNombre.size() > 0
                && request.resource.data.autorNombre.size() <= 120
                && request.resource.data.autorFoto is string
                && request.resource.data.autorFoto.size() <= 1000
                && request.resource.data.creadoEn == request.time
                && request.resource.data.actualizadoEn == request.time;

        }


        function autorContextualCoincideConPerfil() {

            return exists(
                    /databases/$(database)/documents/usuarios/$(request.auth.uid)
                )
                && request.resource.data.autorNombre
                    == perfilActual().nombre
                && request.resource.data.autorFoto
                    == perfilActual().get("foto", "");

        }


        function edicionComentarioContextualValida() {

            return request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly(["texto", "actualizadoEn"])
                && request.resource.data.texto is string
                && request.resource.data.texto.size() > 0
                && request.resource.data.texto.size() <= 500
                && request.resource.data.actualizadoEn == request.time
                && request.resource.data.autorId == resource.data.autorId
                && request.resource.data.creadoEn == resource.data.creadoEn;

        }


        function estrellaContextualValida(usuarioId) {

            return sesionActiva()
                && usuarioId == request.auth.uid
                && request.resource.data.keys().hasAll([
                    "autorId", "creadoEn"
                ])
                && request.resource.data.keys().hasOnly([
                    "autorId", "creadoEn"
                ])
                && request.resource.data.autorId == request.auth.uid
                && request.resource.data.creadoEn == request.time;

        }


        /*
         * Contrato de cada presentación pública.
         */

        function presentacionValida() {

            return request.resource.data.keys()
                .hasAll([
                    "nombre",
                    "fecha",
                    "descripcion",
                    "imagen",
                    "imagenAlt",
                    "boletos",
                    "imagenStorageRuta",
                    "visible",
                    "creadoEn",
                    "actualizadoEn",
                    "actualizadoPor"
                ])

                && request.resource.data.keys()
                    .hasOnly([
                        "nombre",
                        "fecha",
                        "descripcion",
                        "imagen",
                        "imagenAlt",
                        "boletos",
                        "imagenStorageRuta",
                        "visible",
                        "creadoEn",
                        "actualizadoEn",
                        "actualizadoPor"
                    ])

                && request.resource.data.nombre is string
                && request.resource.data.nombre.size() > 0
                && request.resource.data.nombre.size() <= 100

                && request.resource.data.fecha is timestamp

                && request.resource.data.descripcion is string
                && request.resource.data.descripcion.size() > 0
                && request.resource.data.descripcion.size() <= 600

                && request.resource.data.imagen is string
                && request.resource.data.imagen.size() <= 1000
                && (
                    request.resource.data.imagen == ""
                    || request.resource.data.imagen.matches('^https?://.+')
                    || request.resource.data.imagen.matches('^(img/|\\./|\\.\\./).+')
                )

                && request.resource.data.imagenAlt is string
                && request.resource.data.imagenAlt.size() > 0
                && request.resource.data.imagenAlt.size() <= 160

                && request.resource.data.boletos is string
                && request.resource.data.boletos.size() <= 1000
                && (
                    request.resource.data.boletos == ""
                    || request.resource.data.boletos.matches('^https?://.+')
                )

                && request.resource.data.imagenStorageRuta is string
                && request.resource.data.imagenStorageRuta.size() <= 500
                && (
                    request.resource.data.imagenStorageRuta == ""
                    || request.resource.data.imagenStorageRuta.matches(
                        '^presentaciones/.+'
                    )
                )

                && request.resource.data.visible is bool
                && request.resource.data.creadoEn is timestamp
                && request.resource.data.actualizadoEn == request.time
                && request.resource.data.actualizadoPor == request.auth.uid;

        }


        /*
         * Contratos del contenido administrable de Galería y Música.
         * Se aceptan URLs públicas o rutas relativas incluidas en el sitio.
         */

        function elementoGaleriaValido() {

            return request.resource.data.keys().hasAll([
                    "titulo", "descripcion", "imagen", "imagenAlt",
                    "tamano", "orden", "visible", "creadoEn",
                    "actualizadoEn", "actualizadoPor"
                ])
                && request.resource.data.keys().hasOnly([
                    "titulo", "descripcion", "imagen", "imagenAlt",
                    "tamano", "orden", "visible", "creadoEn",
                    "actualizadoEn", "actualizadoPor"
                ])
                && request.resource.data.titulo is string
                && request.resource.data.titulo.size() > 0
                && request.resource.data.titulo.size() <= 120
                && request.resource.data.descripcion is string
                && request.resource.data.descripcion.size() <= 600
                && request.resource.data.imagen is string
                && request.resource.data.imagen.size() > 0
                && request.resource.data.imagen.size() <= 1000
                && (
                    request.resource.data.imagen.matches('^https?://.+')
                    || request.resource.data.imagen.matches('^(img/|\\./|\\.\\./).+')
                )
                && request.resource.data.imagenAlt is string
                && request.resource.data.imagenAlt.size() > 0
                && request.resource.data.imagenAlt.size() <= 180
                && request.resource.data.tamano in ["normal", "grande"]
                && request.resource.data.orden is int
                && request.resource.data.orden >= 0
                && request.resource.data.orden <= 10000
                && request.resource.data.visible is bool
                && request.resource.data.creadoEn is timestamp
                && request.resource.data.actualizadoEn == request.time
                && request.resource.data.actualizadoPor == request.auth.uid;

        }


        function elementoMusicaValido() {

            return request.resource.data.keys().hasAll([
                    "tipo", "titulo", "lanzamiento", "imagen", "imagenAlt",
                    "enlace", "orden", "visible", "creadoEn",
                    "actualizadoEn", "actualizadoPor"
                ])
                && request.resource.data.keys().hasOnly([
                    "tipo", "titulo", "lanzamiento", "imagen", "imagenAlt",
                    "enlace", "orden", "visible", "creadoEn",
                    "actualizadoEn", "actualizadoPor"
                ])
                && request.resource.data.tipo is string
                && request.resource.data.tipo.size() > 0
                && request.resource.data.tipo.size() <= 80
                && request.resource.data.titulo is string
                && request.resource.data.titulo.size() > 0
                && request.resource.data.titulo.size() <= 120
                && request.resource.data.lanzamiento is string
                && request.resource.data.lanzamiento.size() <= 120
                && request.resource.data.imagen is string
                && request.resource.data.imagen.size() > 0
                && request.resource.data.imagen.size() <= 1000
                && (
                    request.resource.data.imagen.matches('^https?://.+')
                    || request.resource.data.imagen.matches('^(img/|\\./|\\.\\./).+')
                )
                && request.resource.data.imagenAlt is string
                && request.resource.data.imagenAlt.size() > 0
                && request.resource.data.imagenAlt.size() <= 180
                && request.resource.data.enlace is string
                && request.resource.data.enlace.size() <= 1000
                && (
                    request.resource.data.enlace == ""
                    || request.resource.data.enlace.matches('^https?://.+')
                )
                && request.resource.data.orden is int
                && request.resource.data.orden >= 0
                && request.resource.data.orden <= 10000
                && request.resource.data.visible is bool
                && request.resource.data.creadoEn is timestamp
                && request.resource.data.actualizadoEn == request.time
                && request.resource.data.actualizadoPor == request.auth.uid;

        }


        function elementoNoticiaValido() {

            return request.resource.data.keys().hasAll([
                    "titulo", "descripcion", "fecha", "imagen", "imagenes", "imagenAlt",
                    "instagram", "facebook", "x", "tiktok", "orden", "visible",
                    "creadoEn", "actualizadoEn", "actualizadoPor"
                ])
                && request.resource.data.keys().hasOnly([
                    "titulo", "descripcion", "fecha", "imagen", "imagenes", "imagenAlt",
                    "instagram", "facebook", "x", "tiktok", "orden", "visible",
                    "creadoEn", "actualizadoEn", "actualizadoPor"
                ])
                && request.resource.data.titulo is string
                && request.resource.data.titulo.size() > 0
                && request.resource.data.titulo.size() <= 120
                && request.resource.data.descripcion is string
                && request.resource.data.descripcion.size() > 0
                && request.resource.data.descripcion.size() <= 1200
                && request.resource.data.fecha is string
                && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && request.resource.data.imagen is string
                && request.resource.data.imagen.size() > 0
                && request.resource.data.imagen.size() <= 1000
                && request.resource.data.imagen.matches('^(img/|\\./|\\.\\./).+')
                && request.resource.data.imagenes is list
                && request.resource.data.imagenes.size() > 0
                && request.resource.data.imagenes.size() <= 20
                && request.resource.data.imagenes[0] == request.resource.data.imagen
                && request.resource.data.imagenes.toSet().size()
                    == request.resource.data.imagenes.size()
                && request.resource.data.imagenAlt is string
                && request.resource.data.imagenAlt.size() > 0
                && request.resource.data.imagenAlt.size() <= 180
                && request.resource.data.instagram is string
                && request.resource.data.instagram.size() <= 1000
                && request.resource.data.facebook is string
                && request.resource.data.facebook.size() <= 1000
                && request.resource.data.x is string
                && request.resource.data.x.size() <= 1000
                && request.resource.data.tiktok is string
                && request.resource.data.tiktok.size() <= 1000
                && (request.resource.data.instagram == "" || request.resource.data.instagram.matches('^https?://.+'))
                && (request.resource.data.facebook == "" || request.resource.data.facebook.matches('^https?://.+'))
                && (request.resource.data.x == "" || request.resource.data.x.matches('^https?://.+'))
                && (request.resource.data.tiktok == "" || request.resource.data.tiktok.matches('^https?://.+'))
                && request.resource.data.orden is int
                && request.resource.data.orden >= 0
                && request.resource.data.orden <= 10000
                && request.resource.data.visible is bool
                && request.resource.data.creadoEn is timestamp
                && request.resource.data.actualizadoEn == request.time
                && request.resource.data.actualizadoPor == request.auth.uid;

        }


        // =========================================
        // USUARIOS
        // =========================================

        match /usuarios/{usuarioId} {

            allow read:
                if esPropietario(usuarioId)
                || esAdministrador()
                || (
                    sesionActiva()
                    && !resource.data.keys().hasAny(["correo", "edad", "redes"])
                );


            /*
             * Un usuario nuevo solo puede crear
             * un perfil normal de viajero.
             */

            allow create:
                if esPropietario(usuarioId)

                && request.resource.data.rol
                    in [
                        "viajero",
                        "usuario"
                    ]

                && request.resource.data.verificado
                    == false

                && (
                    !request.resource.data.keys()
                        .hasAny([
                            "oficial"
                        ])

                    ||

                    request.resource.data.oficial
                        == false
                );


            /*
             * El usuario puede editar su perfil,
             * pero únicamente estos campos.
             *
             * No puede cambiar:
             * rol, oficial, verificado, correo,
             * fechaRegistro ni contadores.
             */

            allow update:
                if esPropietario(usuarioId)

                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                        "nombre",
                        "biografia",
                        "foto",
                        "portada",
                        "actualizadoEn",
                        "publicaciones",
                        "comentarios",
                        "favoritos",
                        "constelacionTotal",
                        "correo",
                        "edad",
                        "redes"
                    ]);


            allow delete:
                if false;


            // Datos que no deben formar parte del perfil público.
            match /privado/{documento} {

                allow read:
                    if documento == "perfil"
                    && (
                        esPropietario(usuarioId)
                        || esAdministrador()
                        || (
                            sesionActiva()
                            && exists(
                                /databases/$(database)/documents/usuarios/$(request.auth.uid)/constelacion/$(usuarioId)
                            )
                        )
                    );

                allow create, update:
                    if documento == "perfil"
                    && esPropietario(usuarioId)
                    && request.resource.data.keys().hasOnly([
                        "correo",
                        "edad",
                        "redes"
                    ]);

                allow delete:
                    if false;

            }


            match /constelacion/{viajeroId} {

                allow read:
                    if sesionActiva();

                allow create:
                    if sesionActiva()
                    && viajeroId != usuarioId
                    && request.resource.data.uid == viajeroId
                    && (
                        (esPropietario(usuarioId) && exists(/databases/$(database)/documents/usuarios/$(usuarioId)/invitaciones/$(viajeroId)))
                        || (request.auth.uid == viajeroId && exists(/databases/$(database)/documents/usuarios/$(viajeroId)/invitaciones/$(usuarioId)))
                    );

                allow update:
                    if false;

                allow delete:
                    if sesionActiva() && (request.auth.uid == usuarioId || request.auth.uid == viajeroId);

            }


            match /invitaciones/{remitenteId} {

                allow read, delete:
                    if sesionActiva() && (request.auth.uid == usuarioId || request.auth.uid == remitenteId);

                allow create:
                    if sesionActiva()
                    && request.auth.uid == remitenteId
                    && usuarioId != remitenteId
                    && request.resource.data.remitenteId == remitenteId
                    && request.resource.data.estado == "pendiente";

                allow update:
                    if false;

            }


            match /notificaciones/{notificacionId} {

                allow read, delete:
                    if esPropietario(usuarioId);

                allow create:
                    if sesionActiva()
                    && usuarioId != request.auth.uid
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.tipo in ["eco", "estrella", "constelacion"]
                    && request.resource.data.leida == false;

                allow update:
                    if esPropietario(usuarioId)
                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly(["leida"])
                    && request.resource.data.leida == true;

            }

        }

        function moderacionContextualValida() {
            return esAdministrador()
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(["oculta", "moderadaPor", "actualizadoEn"])
                && request.resource.data.moderadaPor == request.auth.uid;
        }


        // =========================================
        // CONFIGURACIÓN PÚBLICA
        // =========================================

        match /configuracion/proximo-lanzamiento {

            /*
             * El sitio público podrá leer el lanzamiento
             * sin exigir una sesión de Firebase.
             */

            allow read:
                if resource.data.visible == true
                || esAdministrador();


            /*
             * La creación y actualización requieren sesión,
             * rol administrativo y un documento válido.
             */

            allow create, update:
                if esAdministrador()
                && lanzamientoValido();


            allow delete:
                if esAdministrador();


            match /hilos/{hiloId}/comentarios/{comentarioId} {

                allow read:
                    if (
                        get(
                            /databases/$(database)/documents/configuracion/proximo-lanzamiento
                        ).data.visible == true
                        && get(
                            /databases/$(database)/documents/configuracion/proximo-lanzamiento
                        ).data.get(
                            "hiloComentariosId",
                            "proximo-lanzamiento-inicial"
                        ) == hiloId
                    )
                    || esAdministrador();

                allow create:
                    if sesionActiva()
                    && get(
                        /databases/$(database)/documents/configuracion/proximo-lanzamiento
                    ).data.visible == true
                    && get(
                        /databases/$(database)/documents/configuracion/proximo-lanzamiento
                    ).data.get(
                        "hiloComentariosId",
                        "proximo-lanzamiento-inicial"
                    ) == hiloId
                    && comentarioContextualValido()
                    && autorContextualCoincideConPerfil();

                allow update:
                    if sesionActiva()
                    && resource.data.autorId == request.auth.uid
                    && edicionComentarioContextualValida();

                allow delete:
                    if sesionActiva()
                    && (
                        resource.data.autorId == request.auth.uid
                        || esAdministrador()
                    );

                match /respuestas/{respuestaId} {
                    allow read:
                        if (
                            get(/databases/$(database)/documents/configuracion/proximo-lanzamiento).data.visible == true
                            && get(/databases/$(database)/documents/configuracion/proximo-lanzamiento).data.get(
                                "hiloComentariosId", "proximo-lanzamiento-inicial"
                            ) == hiloId
                        ) || esAdministrador();
                    allow create:
                        if sesionActiva()
                        && get(/databases/$(database)/documents/configuracion/proximo-lanzamiento).data.visible == true
                        && comentarioContextualValido()
                        && autorContextualCoincideConPerfil();
                    allow update:
                        if sesionActiva()
                        && resource.data.autorId == request.auth.uid
                        && edicionComentarioContextualValida();
                    allow delete:
                        if sesionActiva()
                        && (resource.data.autorId == request.auth.uid || esAdministrador());
                }

                match /estrellas/{usuarioId} {
                    allow read:
                        if get(/databases/$(database)/documents/configuracion/proximo-lanzamiento).data.visible == true
                        || esAdministrador();
                    allow create:
                        if estrellaContextualValida(usuarioId)
                        && get(/databases/$(database)/documents/configuracion/proximo-lanzamiento).data.visible == true;
                    allow update: if false;
                    allow delete:
                        if sesionActiva() && usuarioId == request.auth.uid;
                }

            }

            match /hilos/{hiloId}/estrellas/{usuarioId} {

                allow read:
                    if (
                        get(
                            /databases/$(database)/documents/configuracion/proximo-lanzamiento
                        ).data.visible == true
                        && get(
                            /databases/$(database)/documents/configuracion/proximo-lanzamiento
                        ).data.get(
                            "hiloComentariosId",
                            "proximo-lanzamiento-inicial"
                        ) == hiloId
                    )
                    || esAdministrador();

                allow create:
                    if estrellaContextualValida(usuarioId)
                    && get(
                        /databases/$(database)/documents/configuracion/proximo-lanzamiento
                    ).data.visible == true
                    && get(
                        /databases/$(database)/documents/configuracion/proximo-lanzamiento
                    ).data.get(
                        "hiloComentariosId",
                        "proximo-lanzamiento-inicial"
                    ) == hiloId;

                allow update:
                    if false;

                allow delete:
                    if sesionActiva()
                    && usuarioId == request.auth.uid;

            }

        }


        // =========================================
        // PRESENTACIONES
        // =========================================

        match /presentaciones/{presentacionId} {

            allow read:
                if resource.data.visible == true
                || esAdministrador();


            allow create:
                if esAdministrador()
                && presentacionValida()
                && request.resource.data.creadoEn == request.time;


            allow update:
                if esAdministrador()
                && presentacionValida()
                && request.resource.data.creadoEn
                    == resource.data.creadoEn;


            allow delete:
                if esAdministrador();


            match /comentarios/{comentarioId} {

                allow read:
                    if get(
                        /databases/$(database)/documents/presentaciones/$(presentacionId)
                    ).data.visible == true
                    || esAdministrador();

                allow create:
                    if sesionActiva()
                    && get(
                        /databases/$(database)/documents/presentaciones/$(presentacionId)
                    ).data.visible == true
                    && comentarioContextualValido()
                    && autorContextualCoincideConPerfil();

                allow update:
                    if sesionActiva()
                    && resource.data.autorId == request.auth.uid
                    && edicionComentarioContextualValida();

                allow delete:
                    if sesionActiva()
                    && (
                        resource.data.autorId == request.auth.uid
                        || esAdministrador()
                    );

                match /respuestas/{respuestaId} {
                    allow read:
                        if get(/databases/$(database)/documents/presentaciones/$(presentacionId)).data.visible == true
                        || esAdministrador();
                    allow create:
                        if sesionActiva()
                        && get(/databases/$(database)/documents/presentaciones/$(presentacionId)).data.visible == true
                        && comentarioContextualValido()
                        && autorContextualCoincideConPerfil();
                    allow update:
                        if sesionActiva()
                        && resource.data.autorId == request.auth.uid
                        && edicionComentarioContextualValida();
                    allow delete:
                        if sesionActiva()
                        && (resource.data.autorId == request.auth.uid || esAdministrador());
                }

                match /estrellas/{usuarioId} {
                    allow read:
                        if get(/databases/$(database)/documents/presentaciones/$(presentacionId)).data.visible == true
                        || esAdministrador();
                    allow create:
                        if estrellaContextualValida(usuarioId)
                        && get(/databases/$(database)/documents/presentaciones/$(presentacionId)).data.visible == true;
                    allow update: if false;
                    allow delete:
                        if sesionActiva() && usuarioId == request.auth.uid;
                }

            }

            match /estrellas/{usuarioId} {

                allow read:
                    if get(
                        /databases/$(database)/documents/presentaciones/$(presentacionId)
                    ).data.visible == true
                    || esAdministrador();

                allow create:
                    if estrellaContextualValida(usuarioId)
                    && get(
                        /databases/$(database)/documents/presentaciones/$(presentacionId)
                    ).data.visible == true;

                allow update:
                    if false;

                allow delete:
                    if sesionActiva()
                    && usuarioId == request.auth.uid;

            }

        }


        // =========================================
        // NOTICIAS
        // =========================================

        match /noticias/{noticiaId} {

            allow read:
                if resource.data.visible == true
                || esAdministrador();

            allow create:
                if esAdministrador()
                && elementoNoticiaValido()
                && request.resource.data.creadoEn == request.time;

            allow update:
                if esAdministrador()
                && elementoNoticiaValido()
                && request.resource.data.creadoEn == resource.data.creadoEn;

            allow delete:
                if esAdministrador();

            match /comentarios/{comentarioId} {

                allow read:
                    if get(
                        /databases/$(database)/documents/noticias/$(noticiaId)
                    ).data.visible == true
                    || esAdministrador();

                allow create:
                    if sesionActiva()
                    && get(
                        /databases/$(database)/documents/noticias/$(noticiaId)
                    ).data.visible == true
                    && comentarioContextualValido()
                    && autorContextualCoincideConPerfil();

                allow update:
                    if sesionActiva()
                    && resource.data.autorId == request.auth.uid
                    && edicionComentarioContextualValida();

                allow delete:
                    if sesionActiva()
                    && (
                        resource.data.autorId == request.auth.uid
                        || esAdministrador()
                    );

                match /respuestas/{respuestaId} {
                    allow read:
                        if get(/databases/$(database)/documents/noticias/$(noticiaId)).data.visible == true
                        || esAdministrador();
                    allow create:
                        if sesionActiva()
                        && get(/databases/$(database)/documents/noticias/$(noticiaId)).data.visible == true
                        && comentarioContextualValido()
                        && autorContextualCoincideConPerfil();
                    allow update:
                        if sesionActiva()
                        && resource.data.autorId == request.auth.uid
                        && edicionComentarioContextualValida();
                    allow delete:
                        if sesionActiva()
                        && (resource.data.autorId == request.auth.uid || esAdministrador());
                }

                match /estrellas/{usuarioId} {
                    allow read:
                        if get(/databases/$(database)/documents/noticias/$(noticiaId)).data.visible == true
                        || esAdministrador();
                    allow create:
                        if estrellaContextualValida(usuarioId)
                        && get(/databases/$(database)/documents/noticias/$(noticiaId)).data.visible == true;
                    allow update: if false;
                    allow delete:
                        if sesionActiva() && usuarioId == request.auth.uid;
                }

            }

            match /estrellas/{usuarioId} {

                allow read:
                    if get(
                        /databases/$(database)/documents/noticias/$(noticiaId)
                    ).data.visible == true
                    || esAdministrador();

                allow create:
                    if estrellaContextualValida(usuarioId)
                    && get(
                        /databases/$(database)/documents/noticias/$(noticiaId)
                    ).data.visible == true;

                allow update:
                    if false;

                allow delete:
                    if sesionActiva()
                    && usuarioId == request.auth.uid;

            }

        }


        // =========================================
        // GALERÍA
        // =========================================

        match /galeria/{elementoId} {

            allow read:
                if resource.data.visible == true
                || esAdministrador();

            allow create:
                if esAdministrador()
                && elementoGaleriaValido()
                && request.resource.data.creadoEn == request.time;

            allow update:
                if esAdministrador()
                && elementoGaleriaValido()
                && request.resource.data.creadoEn == resource.data.creadoEn;

            allow delete:
                if esAdministrador();

        }


        // =========================================
        // MÚSICA
        // =========================================

        match /musica/{elementoId} {

            allow read:
                if resource.data.visible == true
                || esAdministrador();

            allow create:
                if esAdministrador()
                && elementoMusicaValido()
                && request.resource.data.creadoEn == request.time;

            allow update:
                if esAdministrador()
                && elementoMusicaValido()
                && request.resource.data.creadoEn == resource.data.creadoEn;

            allow delete:
                if esAdministrador();

        }


        // =========================================
        // OBSERVACIONES
        // =========================================

        match /observaciones/{observacionId} {

            allow read:
                if sesionActiva();


            /*
             * Publicación normal:
             * oficial y verificado deben ser falsos.
             *
             * Publicación oficial:
             * el perfil debe pertenecer al
             * Sistema Planetario.
             */

            allow create:
                if sesionActiva()

                && request.resource.data.autorId
                    == request.auth.uid

                && request.resource.data.texto
                    is string

                && request.resource.data.texto.size()
                    > 0

                && request.resource.data.texto.size()
                    <= 800

                && request.resource.data.estrellas
                    == 0

                && request.resource.data.ecos
                    == 0

                && (
                    (
                        !esSistemaPlanetario()

                        && request.resource.data.oficial
                            == false

                        && request.resource.data.verificado
                            == false
                    )

                    ||

                    (
                        esSistemaPlanetario()

                        && request.resource.data.oficial
                            == true

                        && request.resource.data.verificado
                            == true

                        && request.resource.data.autorRango
                            == "Sistema Planetario"
                    )
                );


            /*
             * El propietario solo puede editar
             * el contenido editable de su publicación.
             *
             * No puede cambiar autor, rol, estado
             * oficial, verificación ni contadores.
             */

            allow update:
                if sesionActiva()

                && (
                    (
                        resource.data.autorId
                            == request.auth.uid

                        && request.resource.data
                            .diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                                "texto",
                                "imagen",
                                "editada",
                                "actualizadaEn"
                            ])

                        && request.resource.data.texto
                            is string

                        && request.resource.data.texto.size()
                            > 0

                        && request.resource.data.texto.size()
                            <= 800
                    )

                    ||

                    (
                        request.resource.data
                            .diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                                "estrellas",
                                "actualizadaEn"
                            ])

                        && (
                            request.resource.data.estrellas
                                == resource.data.estrellas + 1

                            ||

                            request.resource.data.estrellas
                                == resource.data.estrellas - 1
                        )

                        && request.resource.data.estrellas
                            >= 0
                    )

                    ||

                    (
                        request.resource.data
                            .diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                                "ecos",
                                "actualizadaEn"
                            ])

                        && (
                            request.resource.data.ecos
                                == resource.data.ecos + 1

                            ||

                            request.resource.data.ecos
                                == resource.data.ecos - 1
                        )

                        && request.resource.data.ecos
                            >= 0
                    )
                );


            allow delete:
                if sesionActiva()
                && (
                    resource.data.autorId == request.auth.uid
                    || esAdministrador()
                );


            // =====================================
            // ESTRELLAS
            // =====================================

            match /estrellas/{usuarioId} {

                allow read:
                    if sesionActiva();


                allow create:
                    if sesionActiva()

                    && request.auth.uid
                        == usuarioId

                    && request.resource.data.usuarioId
                        == request.auth.uid;


                allow delete:
                    if sesionActiva()

                    && request.auth.uid
                        == usuarioId;


                allow update:
                    if false;

            }


            // =====================================
            // ECOS
            // =====================================

            match /ecos/{ecoId} {

                allow read:
                    if sesionActiva();


                allow create:
                    if sesionActiva()

                    && request.resource.data.autorId
                        == request.auth.uid

                    && request.resource.data.texto
                        is string

                    && request.resource.data.texto.size()
                        > 0

                    && request.resource.data.texto.size()
                        <= 500;


                allow update:
                    if moderacionContextualValida()
                    || (
                    sesionActiva()

                    && resource.data.autorId
                        == request.auth.uid

                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                            "texto",
                            "editado",
                            "actualizadaEn"
                        ])

                    && request.resource.data.texto
                        is string

                    && request.resource.data.texto.size()
                        > 0

                    && request.resource.data.texto.size()
                        <= 500
                    );


                allow delete:
                    if sesionActiva()

                    && (
                        resource.data.autorId == request.auth.uid
                        || esAdministrador()
                    );

            }

        }


        // =========================================
        // CONSULTA GLOBAL DE ESTRELLAS
        // =========================================

        match /observaciones/{observacionId} {
            allow update:
                if esAdministrador()
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(["oculta", "moderadaPor", "moderadaEn", "actualizadaEn"])
                && request.resource.data.moderadaPor == request.auth.uid;
            allow delete: if esAdministrador();

            match /ecos/{ecoId} {
                allow update: if moderacionContextualValida();
                allow delete: if esAdministrador();
            }
        }

        match /{rutaComentarios=**}/comentarios/{comentarioId} {
            allow update: if moderacionContextualValida();
            match /respuestas/{respuestaId} {
                allow update: if moderacionContextualValida();
            }
        }

        match /{ruta=**}/estrellas/{estrellaId} {

            allow read:
                if sesionActiva()

                && resource.data.usuarioId
                    == request.auth.uid;

        }

    }

}
